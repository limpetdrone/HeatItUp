{
  "name": "heatitup",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest --runInBand",
    "export": "expo export --platform all",
    "build:ios:local": "node scripts/ios-release.mjs build",
    "submit:ios": "node scripts/ios-release.mjs submit",
    "set-icon": "python3 scripts/apply-icon.py",
    "check:android:release": "node scripts/android-release.mjs check",
    "build:android": "node scripts/android-release.mjs build",
    "submit:android": "node scripts/android-release.mjs submit",
    "release:android": "node scripts/android-release.mjs release",
    "test:release": "node --test scripts/android-release.test.mjs",
    "prepare:ios": "expo prebuild --platform ios",
    "setup:crash-reporting": "node scripts/setup-crash-reporting.mjs",
    "check:crash-reporting": "node scripts/check-crash-reporting.mjs",
    "test:monitoring:setup": "node --test scripts/setup-crash-reporting.test.mjs",
    "release:ios:local": "node scripts/ios-release.mjs release",
    "test:ios:release": "node --test scripts/ios-release.test.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.32",
    "expo-asset": "~57.0.21",
    "expo-audio": "~57.0.5",
    "expo-localization": "~57.0.2",
    "expo-observe": "~57.0.27",
    "expo-splash-screen": "~57.0.11",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "watchman": false
  }
}
